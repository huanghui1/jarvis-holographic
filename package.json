{
  "name": "j.a.r.v.i.s.-holographic-interface",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"BROWSER=none npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.jarvis.holographic",
    "productName": "Jarvis Holographic",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@mediapipe/tasks-vision": "0.10.9",
    "@react-three/drei": "9.105.6",
    "@react-three/fiber": "8.16.6",
    "@react-three/postprocessing": "2.16.2",
    "antd": "^6.1.1",
    "electron-is-dev": "^3.0.1",
    "gsap": "^3.14.2",
    "maath": "^0.10.8",
    "postprocessing": "6.35.4",
    "r3f-perf": "^7.2.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^3.6.0",
    "three": "0.164.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^9.0.3"
  }
}
